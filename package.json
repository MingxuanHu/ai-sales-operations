{
  "name": "ai-sales-operations",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "dev:up": "docker compose up --wait salesOpDb && pnpm --filter './apps/*' --parallel run dev",
    "dev:down": "docker compose stop salesOpDb",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "unit-tests": "pnpm -r run unit-tests",
    "integration-tests": "pnpm --filter @ai-sales-operations/api run integration-tests",
    "build": "pnpm -r run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
