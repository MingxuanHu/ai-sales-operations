{
  "name": "@ai-sales-operations/api",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "pnpm run build && node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "pnpm run prisma:generate && tsc --noEmit",
    "unit-tests": "pnpm run build && node --test",
    "integration-tests": "pnpm run build && node --test integration/health.mjs",
    "build": "pnpm run prisma:generate && tsc",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "prisma": "7.10.1"
  }
}
