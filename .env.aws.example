# Copy to .env.aws and fill in your infrastructure settings as you follow the runbook.
# Keep credentials in AWS SSO and the Google client secret in Secrets Manager.

# AWS access and deployment target
AWS_REGION=ap-southeast-2
AWS_ACCOUNT_ID=
AWS_SSO_START_URL=https://d-xxxxxxxxxx.awsapps.com/start
AWS_SSO_REGION=
AWS_SSO_PERMISSION_SET=

# Local AWS CLI configuration
AWS_PROFILE=sales-operations-dev
AWS_SSO_SESSION=sales-operations

# CloudFormation and Google federation
COGNITO_STACK_NAME=SalesOperationsDevCognito
COGNITO_DOMAIN_PREFIX=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT_URI=
# Secret name or ARN only.
GOOGLE_OAUTH_CLIENT_SECRET_REF=

# Demo web infrastructure
# Copy the DemoWebOrigin output from SalesOperationsDemoWeb after deployment.
DEMO_WEB_ORIGIN=

# Demo Cognito uses a separate Cognito domain prefix in the same AWS target.
DEMO_COGNITO_DOMAIN_PREFIX=

# Demo Google provider registration. The secret JSON contains client_secret.
DEMO_GOOGLE_OAUTH_CLIENT_ID=
DEMO_GOOGLE_OAUTH_CLIENT_SECRET_REF=

# Demo API infrastructure. Name only, as created by the Neon demo runbook.
DEMO_DATABASE_URL_PARAMETER=
