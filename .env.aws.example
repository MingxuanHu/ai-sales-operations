# Copy to .env.aws and fill in your development values as you follow the runbook.
# Keep credentials in AWS SSO and the Google client secret in Secrets Manager.

# AWS access and deployment target
AWS_REGION=ap-southeast-2
AWS_ACCOUNT_ID=
AWS_SSO_START_URL=https://d-xxxxxxxxxx.awsapps.com/start
AWS_SSO_REGION=
AWS_SSO_PERMISSION_SET=

# Local AWS CLI configuration
AWS_PROFILE=sales-operations-dev
AWS_SSO_SESSION=sales-operations

# CloudFormation and Google federation
COGNITO_STACK_NAME=SalesOperationsDevCognito
COGNITO_DOMAIN_PREFIX=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT_URI=
# Secret name or ARN only.
GOOGLE_OAUTH_CLIENT_SECRET_REF=
