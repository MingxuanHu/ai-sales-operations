# Local-only sample. Copy to .env; never commit a populated .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://demo:local-demo-only@localhost:15433/sales_operations?schema=public
DIRECT_URL=postgresql://demo:local-demo-only@localhost:15433/sales_operations?schema=public

# M2: configure a development Cognito User Pool. Public identifiers only.
AWS_REGION=ap-southeast-2
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback

# M9: LLM_API_KEY is intentionally omitted until needed.
