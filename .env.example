# Local-only sample. Copy to .env; never commit a populated .env.
NODE_ENV=development
PORT=3000
# DATABASE_URL is for the API. DIRECT_URL is reserved for Prisma migrations.
# Local values match. See docs/engineering/security.md#postgresql-connection-urls for the demo setup and rationale.
DATABASE_URL=postgresql://demo:local-demo-only@localhost:15433/sales_operations?schema=public
DIRECT_URL=postgresql://demo:local-demo-only@localhost:15433/sales_operations?schema=public

# M2: public Cognito settings. Local NestJS will map shared VITE_ values to its backend settings.
COGNITO_USER_POOL_ID=
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_COGNITO_ISSUER=
VITE_COGNITO_SIGN_OUT_URL=http://localhost:5173/
VITE_COGNITO_API_RESOURCE_URL=http://localhost:5173/api

# M9: LLM_API_KEY is intentionally omitted until needed.
